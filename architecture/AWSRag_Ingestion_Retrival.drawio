        <mxCell id="s4nv_eX2K-Pggb7mto1g-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="User Interface" vertex="1">
          <mxGeometry height="30" width="60" x="114.69999999999999" y="937" as="geometry" />
        </mxCell>
        <mxCell id="s4nv_eX2K-Pggb7mto1g-56" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;enumerate=0;enumerateValue=3;" value="Cognito" vertex="1">
          <mxGeometry height="30" width="60" x="114.30000000000001" y="760" as="geometry" />
        </mxCell>
        <mxCell id="s4nv_eX2K-Pggb7mto1g-65" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&amp;nbsp; &lt;font style=&quot;font-size: 14px;&quot;&gt;Retrieval Pipeline&lt;/font&gt;&lt;/div&gt;&lt;ol&gt;&lt;li&gt;The user submits a query through the interface.&lt;/li&gt;&lt;li&gt;The React-based user interface facilitates user interaction.&lt;/li&gt;&lt;li&gt;User authentication is handled via AWS Cognito.&lt;/li&gt;&lt;li&gt;The user query is forwarded to the FastAPI backend.&lt;/li&gt;&lt;li&gt;The FastAPI backend processes the incoming request.&lt;/li&gt;&lt;li&gt;The query is transferred to queue (SQS)&lt;/li&gt;&lt;li&gt;The Query processing takes place via Query Transformation or HYDE&lt;/li&gt;&lt;li&gt;The query is converted into embeddings using an AWS Bedrock Titan embedding model.&lt;/li&gt;&lt;li&gt;Metadata extraction to be done for filtering chunks on the basis of metadata.&lt;/li&gt;&lt;li&gt;AWS Comprehend will be used for metadata extraction.&lt;/li&gt;&lt;li&gt;Hybrid search will be performed on the basis of Dense and Splade vectors.&lt;/li&gt;&lt;li&gt;The generated embeddings are sent to OpenSearch for hybrid retrieval and most relevant chunks are retrieved.&lt;/li&gt;&lt;li&gt;Reranking of chunks is performed by cohere on bedrock.&lt;/li&gt;&lt;li&gt;The reranked chunks are passed to the AWS Bedrock Claude Sonnet model.&lt;/li&gt;&lt;li&gt;The model generates a response based on the provided context.&lt;/li&gt;&lt;li&gt;The generated response is returned to the FastAPI backend.&lt;/li&gt;&lt;li&gt;The response is stored in DynamoDB as part of the conversation history.&lt;/li&gt;&lt;li&gt;The conversation history is analyzed and utilized as both short-term and long-term memory.&lt;/li&gt;&lt;li&gt;The FastAPI backend sends the final response to the UI for display.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="710" width="230" x="850" y="406" as="geometry" />
        </mxCell>
        <mxCell id="5Z18dDXLKnPu8NKGoF6B-12" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;enumerate=0;enumerateValue=10;" value="" vertex="1">
