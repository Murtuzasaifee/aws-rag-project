        <mxCell id="s4nv_eX2K-Pggb7mto1g-54" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Dynamo Db" vertex="1">
