# ── Copy this file to .env and fill in your values ────────────────────────────
# .env is gitignored — never commit real credentials

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# AWS
AWS_ACCESS_KEY_ID=XYZ
AWS_SECRET_ACCESS_KEY=ABC
AWS_REGION=us-east-1

# S3 — created by StorageStack CDK deploy
S3_BUCKET_NAME=rag-documents-dev

# DynamoDB — created by StorageStack CDK deploy
DYNAMODB_TABLE_NAME=documents

# OpenSearch — get endpoint from VectorDBStack CDK output
OPENSEARCH_ENDPOINT=https://your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=rag-chunks
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ElastiCache Redis — get host from CacheStack CDK output
REDIS_HOST=your-cluster.cache.amazonaws.com
REDIS_PORT=6379

# Bedrock
BEDROCK_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Step Functions — get ARN from ProcessingStack CDK output
STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789:stateMachine:rag-ingestion
